# Porta da API GraphQL
PORT=4002

# Mongo. Se ficar vazio, a API sobe um MongoDB em memória (mongodb-memory-server)
# e semeia os dados automaticamente — útil para rodar sem Docker.
MONGODB_URI=mongodb://127.0.0.1:27022/rekrutar

# Segredo do JWT (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS (portal e admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# URL pública da API (usada para montar o link de download do currículo)
PUBLIC_API_URL=http://localhost:4002

# ---- Shopify ----
# Loja e checkout da assinatura de parceria.
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
# ID da variante do plano de assinatura (Shopify Subscriptions / Selling Plan).
SHOPIFY_SUBSCRIPTION_VARIANT_ID=
# Selling plan opcional (assinatura recorrente)
SHOPIFY_SELLING_PLAN_ID=
# Segredo do webhook (X-Shopify-Hmac-Sha256) — valida orders/paid
SHOPIFY_WEBHOOK_SECRET=
